generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["windows", "native", "rhel-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  
}

model Product {
  id                String           @id @default(cuid())
  category          ProductCategory
  variant           String
  status            ProductStatus    @default(ACTIVE)
  inputs            Json
  subvariants       String[]
  pricingTemplateId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  pricingTemplate   PricingTemplate? @relation(fields: [pricingTemplateId], references: [id])
  orderItems        OrderItem[]

  @@unique([category, variant])
  @@index([status])
  @@index([category])
  @@map("products")
}

model PricingTemplate {
  id        String    @id @default(cuid())
  name      String    @unique
  template  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("pricing_templates")
}

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  password             String
  token                String?       @unique
  recoveryToken        String?       @unique
  recoveryTokenExpires DateTime?
  isActive             String        @default("PENDING")
  role                 UserRole      @default(klient)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  company              Company?
  personalData         PersonalData?
  shipping             Shipping?
  orders               Order[]
}

model PersonalData {
  id        String  @id @default(cuid())
  firstName String?
  lastName  String?
  phone     String?
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shipping {
  id      String  @id @default(cuid())
  city    String?
  address String?
  zipCode String?
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String  @id @default(cuid())
  companyName String?
  nip         String?
  phone       String?
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(DRAFT)
  totalAmount Float
  shipping    Json?       // Store shipping details when order is placed (null for DRAFT)
  customer    Json?       // Store customer details when order is placed (null for DRAFT)
  company     Json?       // Optional company details at time of order
  notes       String?     // Order name (nazwa zlecenia); generated as Zlecenie#(code) if empty
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]

  @@index([status])
  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id             String   @id @default(cuid())
  quantity       Int      // Number of configurations
  configurations Json     // Array of ProductConfiguration objects
  price          Float    // Total price for all configurations
  productData    Json     // Store product data at time of order
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderId        String
  productId      String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum ProductCategory {
  KATEGORIA_A
  KATEGORIA_B
  KATEGORIA_C
  KATEGORIA_D
  KATEGORIA_E
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  TEST
}

enum ProductInputType {
  WIDTH
  HEIGHT
  COLOR
  MATERIAL
  QUANTITY
}

enum UserRole {
  klient
  pracownik
  host
}

enum OrderStatus {
  DRAFT        // In "cart" – not visible in orders list
  UNCONFIRMED  // Initial state when order is placed
  IN_PROGRESS  // Order is being processed
  CONFIRMED    // Order confirmed by admin
  DELIVERED    // Order has been delivered
  CANCELLED    // Order was cancelled
  FINISHED     // Order completed
  PENDING      // Legacy status - keep for compatibility
}

model WarehouseStock {
  id        String   @id @default(cuid())
  name      String   @unique
  quantity  Int      @default(0)
  unit      String?  @default("szt")
  updatedAt DateTime @updatedAt

  @@map("warehouse_stock")
}

model WarehouseIntake {
  id        String   @id @default(cuid())
  intakeId  String   @unique
  label     String?
  items     Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("warehouse_intakes")
}